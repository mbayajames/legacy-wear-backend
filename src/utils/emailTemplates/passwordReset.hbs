<!-- utils/emailTemplates/passwordReset.hbs -->
<!-- Password reset email template - sent when user requests to reset their password -->
<!-- Contains security warnings, expiry information, and a clickable reset link -->

<!DOCTYPE html>
<html>
<head>
  <!-- ========== METADATA ========== -->
  <meta charset="utf-8">
  <!-- Ensures proper rendering on mobile devices -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Reset Request</title>
  
  <!-- ========== STYLES ========== -->
  <style>
    /* Base body styles - consistent across all email templates */
    body {
      font-family: Arial, sans-serif;      /* Clean, universally supported font */
      line-height: 1.6;                     /* Improves readability */
      color: #333;                          /* Dark gray text */
      max-width: 600px;                     /* Standard email width */
      margin: 0 auto;                       /* Center content */
      padding: 20px;
    }
    
    /* Header section with logo */
    .header {
      text-align: center;
      padding: 20px 0;
      border-bottom: 2px solid #f0f0f0;    /* Subtle separator */
    }
    
    /* Brand logo styling */
    .logo {
      font-size: 24px;
      font-weight: bold;
      color: #1a1a1a;
    }
    
    /* Main content area */
    .content {
      padding: 30px 0;
    }
    
    /* Call-to-action button - primary action */
    .button {
      display: inline-block;
      padding: 12px 24px;
      background-color: #000;               /* Brand color - black */
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      margin: 20px 0;
    }
    
    /* Warning box - highlights security information */
    .warning {
      background-color: #fff3cd;            /* Light yellow background */
      border: 1px solid #ffeaa7;            /* Slightly darker yellow border */
      padding: 15px;
      border-radius: 4px;
      margin: 20px 0;
      font-size: 14px;                      /* Slightly smaller text */
    }
    
    /* Footer section */
    .footer {
      text-align: center;
      padding: 20px 0;
      font-size: 12px;
      color: #666;
      border-top: 1px solid #f0f0f0;
    }
  </style>
</head>
<body>
  <!-- ========== HEADER ========== -->
  <div class="header">
    <div class="logo">LEGACY WEAR</div>
    <!-- Brand identity - maintains consistency with other emails -->
  </div>
  
  <!-- ========== MAIN CONTENT ========== -->
  <div class="content">
    <!-- Clear subject line - immediately informs user what this email is about -->
    <h1>Password Reset Request</h1>
    
    <!-- Personal greeting using Handlebars variable -->
    <p>Hello {{name}},</p>
    <!-- {{name}} is replaced with user's actual name for personalization -->
    
    <!-- Clear explanation of why they received this email -->
    <p>We received a request to reset the password for your Legacy Wear account. 
    Click the button below to create a new password:</p>
    
    <!-- Primary Call-to-Action Button -->
    <div style="text-align: center;">
      <a href="{{resetUrl}}" class="button">Reset Password</a>
      <!-- {{resetUrl}} contains the one-time password reset link -->
    </div>
    
    <!-- ========== SECURITY WARNING SECTION ========== -->
    <div class="warning">
      <strong>⚠️ This link will expire in {{expiryMinutes}} minutes.</strong>
      <!-- {{expiryMinutes}} is typically 10 minutes - short window for security -->
      <br><br>
      <!-- Important security note for users who didn't request reset -->
      If you didn't request a password reset, please ignore this email or 
      contact support if you have concerns.
    </div>
    
    <!-- Fallback link for email clients that block buttons or for copy-paste -->
    <p>If the button doesn't work, copy and paste this link into your browser:</p>
    <p style="word-break: break-all; font-size: 12px; color: #666;">{{resetUrl}}</p>
    <!-- word-break: break-all ensures long URLs wrap properly on mobile -->
    
    <!-- Security reminder - never share reset links -->
    <p>For security reasons, never share this link with anyone.</p>
    
    <!-- Sign-off -->
    <p>Best regards,<br>
    The Legacy Wear Team</p>
  </div>
  
  <!-- ========== FOOTER ========== -->
  <div class="footer">
    <!-- Dynamic year - automatically updates -->
    <p>&copy; {{year}} Legacy Wear. All rights reserved.</p>
    <!-- Note: Unsubscribe link not needed for transactional emails (password reset is transactional) -->
  </div>
</body>
</html>